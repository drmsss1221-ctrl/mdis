# ── STP Dashboard Environment Configuration ──────────────────────────────────
# Copy this file and rename to .env, then fill in your real values.
# NEVER commit .env with real secrets to Git.

# ── MongoDB Atlas (Cloud Persistence) ────────────────────────────────────────
# Get a free connection string from https://www.mongodb.com/cloud/atlas
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/stp_dash?retryWrites=true&w=majority

# ── Twilio SMS (for real OTP delivery) ───────────────────────────────────────
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# ── Email (OTP Delivery) ──────────────────────────────────────────────────
# If using Gmail: Use an "App Password" (https://myaccount.google.com/apppasswords)
# If using Outlook/Custom: Use your provider's SMTP settings.
# IF LEFT AS PLACEHOLDERS: The server will automatically use a "Test Account" 
# and give you a link to check the virtual inbox in the terminal.

EMAIL_USER=pzanunjunorz2qcx@ethereal.email
EMAIL_PASS=FgR2mmPxpvHXF4J8p1

# ── SMTP Settings (Default: Gmail) ──────────────────────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false

# ── Google reCAPTCHA v2 ───────────────────────────────────────────────────────
# Get from https://www.google.com/recaptcha/admin
# RECAPTCHA_SECRET=your_recaptcha_secret_key

# ── Server Ports ──────────────────────────────────────────────────────────────
# PORT=3000
# HTTPS_PORT=3443
# NODE_ENV=production
